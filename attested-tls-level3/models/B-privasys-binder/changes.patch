+(* Privasys RA-TLS channel binder (rustls + Go forks, shipped 2026-07):
+   binder = HKDF-Expand-Label(client_handshake_traffic_secret,
+                              "privasys-ratls-binder-v1", Hash(ClientHello..ServerHello), 32)
+   client_handshake_traffic_secret = Derive-Secret(Handshake Secret, "c hs traffic", CH..SH)
+   Folded into the AK-signed quote report_data together with the client nonce and
+   the leaf public key: rdata = (ar, cb, pubEK) below. *)
+letfun kdf_exp(hs:bitstring, log2:bitstring) =
+  let htsc = derive_secret(hs, tls13_client_handshake_traffic_secret, log2) in
+  hkdf_expand_label(htsc, tls13_privasys_binder, hash_ideal(log2)).
 
